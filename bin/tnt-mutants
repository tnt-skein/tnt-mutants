#!/usr/bin/env bash
# Мутационное тестирование Lua-кода для Tarantool.
#
# Зрелого мутационного тестера для Lua нет, поэтому утилита собрана
# из языконезависимого universalmutator и своего набора правил
# rules/lua.rules: встроенный универсальный набор написан под C-подобный
# синтаксис и ломает Lua на комментариях, неравенстве ~= и словах and/or.
#
# Планка по умолчанию — 100 % убитых мутантов по проверяемым файлам. Смысл
# в том, чего не показывает покрытие: заметит ли хоть один тест, если код
# сломать.
#
# Запуск из корня проекта:
#   tnt-mutants                 — по файлам, изменённым относительно базовой ветки
#   tnt-mutants a.lua b.lua     — по указанным файлам
#   tnt-mutants --list          — только назвать файлы, которые проверил бы прогон
#   tnt-mutants selftest        — самопроверка утилиты на файлах-образцах
#
# Настройки читаются из mutants.conf в корне проекта (см. mutants.conf.example)
# и из переменных окружения MUTANTS_*; окружение старше файла.
#
# Правка этого сценария или правил без самопроверки может ослепить утилиту
# при зелёном итоге: она не кричит, когда ломается, а молча перестаёт смотреть.

set -euo pipefail

VERSION='0.1.0'

# Корень утилиты: рядом лежат правила, помощники на Python и окружение
# Python. Ссылки раскрываются, чтобы утилиту можно было положить в PATH
# символической ссылкой.
resolve_tool_root() {
    local script="$0"
    local dir

    while [ -L "${script}" ]; do
        dir=$(cd "$(dirname "${script}")" && pwd -P)
        script=$(readlink "${script}")

        case "${script}" in
            /*) ;;
            *) script="${dir}/${script}" ;;
        esac
    done

    cd "$(dirname "${script}")/.." && pwd -P
}

TOOL_ROOT=$(resolve_tool_root)

usage() {
    cat <<USAGE
Мутационное тестирование Lua-кода для Tarantool (tnt-mutants ${VERSION}).

Запуск из корня проекта:
  tnt-mutants [--config ФАЙЛ] [ФАЙЛ ...]   прогон по изменённым или указанным файлам
  tnt-mutants --list                       назвать файлы, которые проверил бы прогон
  tnt-mutants selftest                     самопроверка утилиты на файлах-образцах
  tnt-mutants --help | --version

Настройки: mutants.conf в корне проекта (образец — mutants.conf.example
в каталоге утилиты) и переменные MUTANTS_*; окружение старше файла.
USAGE
}

# ─── Аргументы ──────────────────────────────────────────────────────────────

list_only=0
config_explicit=''
files=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -V | --version)
            echo "tnt-mutants ${VERSION}"
            exit 0
            ;;
        --list)
            list_only=1
            ;;
        --config)
            if [ "$#" -lt 2 ]; then
                echo 'После --config нужен путь к файлу настроек.' >&2
                exit 2
            fi

            config_explicit="$2"
            shift
            ;;
        --config=*)
            config_explicit="${1#--config=}"
            ;;
        selftest)
            shift
            exec "${TOOL_ROOT}/selftest/run.sh" "$@"
            ;;
        --)
            shift
            files+=("$@")
            break
            ;;
        -*)
            echo "Неизвестный аргумент: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            # Ведущее «./» снимается: список исключений и список файлов без
            # мутантов сравнивают путь буквально, и «./a.lua» не нашёл бы
            # правил, заведённых для «a.lua».
            files+=("${1#./}")
            ;;
    esac

    shift
done

# ─── Настройки ──────────────────────────────────────────────────────────────

# Окружение старше файла настроек: значения MUTANTS_*, пришедшие снаружи,
# запоминаются до чтения файла и возвращаются после него. Так самопроверка
# и разовые запуски подменяют любую настройку, не трогая файл.
env_overrides=''

for name in $(compgen -A variable MUTANTS_ || true); do
    env_overrides+="$(declare -p "${name}");"
done

CONFIG="${config_explicit:-${MUTANTS_CONFIG:-mutants.conf}}"

if [ -f "${CONFIG}" ]; then
    # shellcheck source=/dev/null
    source "${CONFIG}"
elif [ -n "${config_explicit}" ] || [ -n "${MUTANTS_CONFIG:-}" ]; then
    echo "Файл настроек ${CONFIG} не найден." >&2
    exit 1
fi

eval "${env_overrides}"

BASE_REF="${MUTANTS_BASE:-origin/main}"
THRESHOLD="${MUTANTS_MIN_MSI:-100}"

# Правила мутаций. Подмена нужна самопроверке: сломанное правило обязано
# валить прогон, и проверить это можно только на сломанной копии.
RULES="${MUTANTS_RULES:-${TOOL_ROOT}/rules/lua.rules}"

# Списки проекта: правила исключения и файлы без мутантов. Без настройки
# ищутся под своими именами в корне проекта, и отсутствие там — не отказ:
# проекту без исключений заводить пустые файлы незачем. Названный явно
# список обязан существовать: опечатка в пути иначе молча сняла бы все
# правила, и мутанты, которые они должны глушить, выжили бы.
IGNORE="${MUTANTS_IGNORE:-mutants.ignore}"
EMPTY_LIST="${MUTANTS_EMPTY_LIST:-mutants.empty}"

# Рабочий каталог: мутанты, копии исходников, исполнитель, журналы, замок.
WORKDIR="${MUTANTS_WORKDIR:-var/mutants}"

case "${WORKDIR}" in
    /*) WORK_ABS="${WORKDIR}" ;;
    *) WORK_ABS="${PWD}/${WORKDIR}" ;;
esac

MUTANT_DIR="${WORKDIR}/generated"
BACKUP_DIR="${WORKDIR}/backup"
FILE_IGNORE="${WORKDIR}/ignore.txt"
FILE_IGNORE_LINES="${WORKDIR}/ignore-lines.txt"
TEST_RUNNER="${WORKDIR}/run-tests.sh"
LOCK="${WORKDIR}/lock"

# Вывод исполнителя: luatest последнего прогона, отказы запуска, отметка
# исчерпанного предела и список мутантов, убитых пределом. Пути
# абсолютные — исполнитель переходит в корень проекта сам, а анализатор
# зовёт его откуда угодно.
RUNNER_OUTPUT="${WORK_ABS}/runner.out"
LAUNCH_LOG="${WORK_ABS}/launch-error.log"
TIMEOUT_MARK="${WORK_ABS}/runner.timeout"
TIMEOUT_LOG="${WORK_ABS}/timeout.log"

# Чем гонять проверки и чем проверять, что мутант хотя бы загружается.
LUATEST="${MUTANTS_LUATEST:-.rocks/bin/luatest}"
LUA="${MUTANTS_LUA:-tarantool}"

# Аргументы luatest в прогоне под мутантом. Первое падение решает: мутант
# убит, и остаток набора ничего не добавит. Выживший проходит набор целиком;
# приговор тот же, а набор со стендами из нескольких узлов не гоняется
# до конца на каждом мутанте.
#
# Флаг именно короткий: справка luatest обещает и --failure, но разбор
# аргументов знает только -f и --fail-fast. С --failure он падал
# «Unknown option» до первой проверки, и каждый мутант числился убитым
# за долю секунды: прогон показывал сто процентов, ничего не проверив.
# Подмена нужна самопроверке — ею она и ломает строку запуска нарочно.
LUATEST_FLAGS="${MUTANTS_LUATEST_FLAGS:---shuffle none -f}"

# Окружение Python с universalmutator. По умолчанию — рядом с утилитой
# (make setup в её каталоге); проект может указать своё.
VENV="${MUTANTS_VENV:-${TOOL_ROOT}/.venv}"
mutator="${VENV}/bin/mutate"
analyzer="${VENV}/bin/analyze_mutants"
python="${VENV}/bin/python"

# Срок одного мутанта. Предел прогона проверок под мутантом на секунду
# короче таймаута анализатора: к тому мигу, когда тот решит не ждать,
# гасить уже нечего.
#
# Мутант, убитый пределом, числится убитым, а выживший проходит набор
# целиком. Поэтому набор, который идёт почти весь предел, делает убитым
# любого выжившего, стоит машине чуть замедлиться: итог показывает сто
# процентов, ничего не проверив. Срок по умолчанию утилита поднимает под
# набор сама (verify_baseline); явный MUTANTS_TIMEOUT — выбор человека:
# его утилита не трогает, а тесный отвергает до генерации мутантов.
#
# Подмена срока по умолчанию нужна самопроверке: подъём над пятнадцатью
# секундами иначе проверялся бы набором длиной в восемь секунд.
TIMEOUT_EXPLICIT=0

if [ -n "${MUTANTS_TIMEOUT:-}" ]; then
    TIMEOUT_EXPLICIT=1
fi

TIMEOUT_SOURCE='MUTANTS_TIMEOUT'
TIMEOUT="${MUTANTS_TIMEOUT:-}"

if [ "${TIMEOUT_EXPLICIT}" -eq 0 ]; then
    TIMEOUT_SOURCE='MUTANTS_DEFAULT_TIMEOUT'
    TIMEOUT="${MUTANTS_DEFAULT_TIMEOUT:-15}"
fi

# Сколько ждать исходного прогона. Он идёт не под пределом мутанта:
# длительность базы нужно узнать, даже когда она больше предела, —
# иначе нечего ни назвать в отказе, ни взять за основу нового предела.
# Пять минут: набор, идущий дольше, скорее всего висит.
BASELINE_LIMIT="${MUTANTS_BASELINE_LIMIT:-300}"

# Что исполнитель прогона сообщает кодом выхода, кроме кода самого luatest.
# Анализатору важно одно — ноль или нет; различать их нужно утилите.
TIMED_OUT=124
LAUNCH_FAILED=125

# По этой переменной исполнитель отличает прогон под мутантом от базы:
# её задаёт анализатор. Унаследованная снаружи, она выдала бы базу
# за мутанта.
unset CURRENT_MUTANT_SOURCE

# Что считается прикладным кодом.
#
# Каждый шаблон передаётся git отдельным аргументом. Фигурные скобки
# в pathspec git не раскрывает: перечисление в одной строке молча не
# совпадает ни с чем, и прогон пропускает всё подряд.
#
# По умолчанию — весь Lua-код проекта без каталогов проверок: проверки
# прикладным кодом не считаются, мутировать их незачем. Проект с другой
# раскладкой задаёт свой список в MUTANTS_SOURCES.
if declare -p MUTANTS_SOURCES >/dev/null 2>&1; then
    PATHSPEC=("${MUTANTS_SOURCES[@]}")
else
    PATHSPEC=(
        ':(glob)**/*.lua'
        ':(exclude,glob)**/test/**'
        ':(exclude,glob)test/**'
    )
fi

# Каталоги, в которых следы прогона не ищутся: копии исходников кладутся
# рядом с самими исходниками, а этих каталогов среди исходников нет.
PRUNED=(.git .rocks .venv node_modules "${WORKDIR}")

# Где luatest держит каталоги поднятых узлов.
#
# Умолчание у него — общий `/tmp/t`. Пока проект один, это никому
# не мешает; когда копий несколько, каждая вычищает этот каталог под собой
# и уносит узлы соседей. Дальше начинается худшее: чужие файберы
# застревают, цикл событий пустеет, и `luatest` выходит с нулём посреди
# набора — отказы вместе с ним пропадают, а прогон объявляет живого
# мутанта убитым (и наоборот).
#
# По этому же каталогу опознаются свои узлы при уборке. Имя считается
# от пути проекта и держится коротким: в длинный путь не влезает
# `sun_path` управляющего сокета, и узел не поднимается.
VARDIR="${MUTANTS_VARDIR:-/tmp/t-$(printf '%s' "${PWD}" | cksum | cut -d' ' -f1)}"

# Замок машины.
#
# Копий проекта бывает несколько, и у каждой свой рабочий каталог.
# Но процессор один: два прогона сразу идут втрое дольше и, что хуже,
# врут. Тесты не укладываются в срок анализатора, и убитый мутант числится
# выжившим. Поэтому прогоны выстраиваются в очередь по общему замку,
# а не падают: ждущий дожидается своей очереди сам.
MACHINE_LOCK="${MUTANTS_MACHINE_LOCK:-/tmp/tnt-mutants-machine.lock}"

# Сколько ждать очереди. Час: прогон по одному пакету столько и идёт,
# а дольше ждать бессмысленно — значит, впереди застрявший прогон.
QUEUE_WAIT="${MUTANTS_QUEUE_WAIT:-3600}"

# ─── Уборка ─────────────────────────────────────────────────────────────────

# Процессы Tarantool, оставшиеся от прогона.
#
# Прогон под мутантом иногда не завершается: сломанное условие выхода
# оставляет фибер крутиться, и процесс живёт дальше, занимая память
# и грея машину. Анализатор о таких процессах не знает.
#
# Своими считаются узлы, поднятые luatest в каталоге узлов, и сам
# luatest, работающий в корне проекта. Другие процессы Tarantool в корне —
# скажем, узлы приложения, поднятые для разработки, — не трогаются.
#
# Гасятся насмерть, без вежливого TERM: процесс висит потому, что его цикл
# событий сломан или занят навсегда, — сигнал он обработает тогда же, когда
# завершится, то есть никогда.
kill_own_instances() {
    local pid cwd command

    for pid in $(pgrep -x tarantool 2>/dev/null || true); do
        if [ -L "/proc/${pid}/cwd" ]; then
            cwd=$(readlink "/proc/${pid}/cwd" 2>/dev/null) || cwd=''
        else
            cwd=$(lsof -a -p "${pid}" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p') || cwd=''
        fi

        [ -n "${cwd}" ] || continue

        case "${cwd}" in
            "${VARDIR}" | "${VARDIR}"/*)
                kill -KILL "${pid}" 2>/dev/null || true
                ;;
            "${PWD}")
                command=$(ps -o command= -p "${pid}" 2>/dev/null) || command=''

                case "${command}" in
                    *luatest*) kill -KILL "${pid}" 2>/dev/null || true ;;
                esac
                ;;
        esac
    done
}

# Поиск по проекту без служебных каталогов; имена — через нулевой байт,
# чтобы пробел в пути не разбил имя надвое.
find_in_project() {
    local prune=()
    local dir

    for dir in "${PRUNED[@]}"; do
        prune+=(-path "./${dir#./}" -prune -o)
    done

    find . "${prune[@]}" \( "$@" \) -print0 2>/dev/null || true
}

# Анализатор подменяет исходный файл мутантом, поэтому оригиналы кладутся
# в сторону и возвращаются на место при любом исходе, включая Ctrl-C.
restore_sources() {
    kill_own_instances

    # Копии генератора и анализатора лежат рядом с исходником; свой
    # временный вывод они пишут в корень.
    find_in_project -name '*.um.backup' -o -name '*.um.backup.*' | xargs -0 rm -f 2>/dev/null || true
    find . -maxdepth 1 -name '.tmp_mutant.*' -delete 2>/dev/null || true
    find . -maxdepth 1 -name '.um.mutant_output.*' -delete 2>/dev/null || true
    rm -f "${TIMEOUT_MARK}".*

    if [ -d "${BACKUP_DIR}" ]; then
        for backup in "${BACKUP_DIR}"/*.bak; do
            [ -e "${backup}" ] || continue
            original=$(basename "${backup}" .bak | tr '@' '/')
            cp "${backup}" "${original}"
        done
        rm -rf "${BACKUP_DIR}"
    fi
}

# Уборка — только за собой.
#
# Прогон, который отказал до замка (второй запуск рядом с живым, неверный
# аргумент, пустой список), не владеет ни замком, ни подменёнными
# исходниками. Уборка на любом выходе снимала бы замок живого прогона,
# гасила его узлы и возвращала исходники посреди его анализа.
#
# Замок снимается только в конце: restore_sources вызывается и между
# файлами, а прогон при этом продолжается.
finish() {
    if [ "${LOCK_HELD:-}" = '1' ]; then
        rm -f "${LOCK}"
        restore_sources
    fi

    # Замок машины снимается только тем, кто его поставил: прогон, ждущий
    # очереди, не должен снять чужой замок и пойти вторым.
    if [ "${MACHINE_LOCK_HELD:-}" = '1' ]; then
        rm -f "${MACHINE_LOCK}"
    fi
}

# Прерывание завершает прогон, а не только зовёт уборку: иначе после
# Ctrl-C сценарий шёл бы дальше, к следующему файлу, уже без замка.
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ─── Список файлов ──────────────────────────────────────────────────────────

# Файлы, изменённые относительно базовой ветки. Учитываются три источника,
# иначе проверка молчит ровно тогда, когда она нужнее всего — пока код
# пишется:
#   1. коммиты этой ветки поверх базовой;
#   2. правки в индексе и рабочем дереве;
#   3. новые файлы, ещё не добавленные под версионирование.
collect_changed_files() {
    {
        if git rev-parse --verify --quiet "${BASE_REF}" >/dev/null; then
            git diff --name-only "${BASE_REF}...HEAD" -- "${PATHSPEC[@]}"
        fi

        # HEAD существует не всегда: в репозитории без коммитов сравнивать не с чем.
        if git rev-parse --verify --quiet HEAD >/dev/null; then
            git diff --name-only HEAD -- "${PATHSPEC[@]}"
        else
            git diff --name-only --cached -- "${PATHSPEC[@]}"
        fi

        git ls-files --others --exclude-standard -- "${PATHSPEC[@]}"
    } | sort -u
}

explicit=0

if [ "${#files[@]}" -gt 0 ]; then
    explicit=1
elif ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo 'Каталог не под git: без базовой ветки изменённые файлы не найти, назовите файлы явно.' >&2
    exit 1
elif ! git rev-parse --verify --quiet "${BASE_REF}" >/dev/null; then
    echo "Базовая ветка ${BASE_REF} недоступна (MUTANTS_BASE): проверяется весь прикладной код." >&2
    mapfile -t files < <({ git ls-files -- "${PATHSPEC[@]}"; git ls-files --others --exclude-standard -- "${PATHSPEC[@]}"; } | sort -u)
else
    mapfile -t files < <(collect_changed_files)
fi

if [ "${list_only}" -eq 1 ]; then
    if [ "${#files[@]}" -gt 0 ]; then
        printf '%s\n' "${files[@]}"
    fi

    exit 0
fi

if [ "${#files[@]}" -eq 0 ]; then
    echo 'Изменений в прикладном коде нет — мутационная проверка пропущена.'
    exit 0
fi

# Явно названный файл, которого нет, — опечатка, а не «проверять нечего».
# Пропущенный молча, он давал бы нулевой код, ничего не проверив.
# Удалённый файл из списка изменений пропускается: проверять в нём
# действительно нечего.
if [ "${explicit}" -eq 1 ]; then
    missing=0

    for source in "${files[@]}"; do
        if [ ! -f "${source}" ]; then
            echo "Файл не найден: ${source}" >&2
            missing=$((missing + 1))
        fi
    done

    if [ "${missing}" -gt 0 ]; then
        echo "Мутационная проверка не начата: не найдено файлов ${missing}." >&2
        exit 1
    fi
fi

# ─── Проверка окружения ─────────────────────────────────────────────────────

if [ ! -x "${mutator}" ] || [ ! -x "${analyzer}" ] || [ ! -x "${python}" ]; then
    echo "universalmutator не найден в ${VENV}: выполните \`make setup\` в ${TOOL_ROOT}" >&2
    echo '   или укажите своё окружение Python в MUTANTS_VENV.' >&2
    exit 1
fi

if [ ! -f "${RULES}" ]; then
    echo "Файл правил мутаций ${RULES} не найден." >&2
    exit 1
fi

if [ ! -f "${IGNORE}" ]; then
    if [ -n "${MUTANTS_IGNORE:-}" ]; then
        echo "Список правил исключения ${IGNORE} не найден." >&2
        exit 1
    fi

    IGNORE=''
fi

if [ ! -f "${EMPTY_LIST}" ]; then
    if [ -n "${MUTANTS_EMPTY_LIST:-}" ]; then
        echo "Список файлов без мутантов ${EMPTY_LIST} не найден." >&2
        exit 1
    fi

    EMPTY_LIST=''
fi

# Длительность базы меряется по EPOCHREALTIME, а он есть только с bash 5.0.
# Без него set -u оборвал бы прогон невнятным «unbound variable».
if [ -z "${EPOCHREALTIME:-}" ]; then
    echo "tnt-mutants нужен bash 5.0 или новее, а запущен ${BASH_VERSION}." >&2
    exit 1
fi

# Срок — целое число секунд больше нуля. Дробь роняет арифметику bash
# посреди прогона, а слово она молча читает нулём.
require_seconds() {
    if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
        echo "$1 — целое число секунд больше нуля, а задано «$2»." >&2
        exit 1
    fi
}

require_seconds "${TIMEOUT_SOURCE}" "${TIMEOUT}"
require_seconds 'MUTANTS_BASELINE_LIMIT' "${BASELINE_LIMIT}"

RUN_LIMIT=$((TIMEOUT - 1))

if [ "${RUN_LIMIT}" -lt 1 ]; then
    RUN_LIMIT=1
fi

# Базу утилита ждёт не меньше, чем мутанта: кто дал мутанту десять минут,
# готов столько же ждать и базу, а в отказе получит её длительность
# вместо «не уложилась».
if [ "${BASELINE_LIMIT}" -lt "${RUN_LIMIT}" ]; then
    BASELINE_LIMIT="${RUN_LIMIT}"
fi

# ─── Наборы проверок ────────────────────────────────────────────────────────

# Какие проверки прогонять для файла, если проект не задал своего правила.
#
# Ближайший каталог `test/` вверх по дереву от файла: у пакета внутри
# большого репозитория это `<пакет>/test/`, у отдельного пакета — `test/`
# в корне. Модуль проверяется набором своего пакета: он тот же, что
# отвечает за покрытие модуля, а прогон всего репозитория вместо него
# удлиняет проверку одного файла в разы.
default_tests_for() {
    local dir
    dir=$(dirname "$1")

    while true; do
        if [ -d "${dir}/test" ]; then
            if [ "${dir}" = '.' ]; then
                echo 'test/'
            else
                echo "${dir}/test/"
            fi

            return 0
        fi

        if [ "${dir}" = '.' ] || [ "${dir}" = '/' ]; then
            return 1
        fi

        dir=$(dirname "${dir}")
    done
}

# Набор для файла: MUTANTS_SUITE старше всего (так самопроверка гоняет
# проверки образцов), затем правило проекта tests_for из файла настроек,
# затем умолчание.
suite_for() {
    if [ -n "${MUTANTS_SUITE:-}" ]; then
        echo "${MUTANTS_SUITE}"
        return 0
    fi

    if declare -F tests_for >/dev/null; then
        tests_for "$1"
        return
    fi

    default_tests_for "$1"
}

# Наборы узнаются до замков и баз: файл, для которого набора нет, —
# отказ до того, как прогон что-либо тронул.
declare -A suite_of=()
unresolved=0

for source in "${files[@]}"; do
    [ -f "${source}" ] || continue

    if suite=$(suite_for "${source}") && [ -n "${suite}" ]; then
        suite_of["${source}"]="${suite}"
    else
        echo "Для ${source} не найден набор проверок: ни рядом, ни выше нет каталога test/." >&2
        unresolved=$((unresolved + 1))
    fi
done

if [ "${unresolved}" -gt 0 ]; then
    echo "Мутационная проверка не начата: файлов без набора проверок ${unresolved}." >&2
    echo '   Задайте правило tests_for в mutants.conf или набор целиком в MUTANTS_SUITE.' >&2
    exit 1
fi

# ─── Правила исключения ─────────────────────────────────────────────────────

# Исключения для одного файла.
#
# Генератору список уходит как есть — выражениями по одному на строку, —
# поэтому отбор делается здесь: из общего списка берутся строки своего
# файла, путь отбрасывается.
#
# Правило обязано знать свой файл. Плоский список — выражения без путей —
# слепит такие же строки во всех остальных файлах, и прогон показывает
# сто процентов по строкам, которых никто не проверял.
#
# Рядом, строка в строку, ложатся номера правил в общем списке: по ним
# сверка выражений называет правило, которое надо чинить.
ignore_for() {
    local source="$1"

    mkdir -p "${WORKDIR}"

    if [ -z "${IGNORE}" ]; then
        : > "${FILE_IGNORE}"
        : > "${FILE_IGNORE_LINES}"
        return
    fi

    awk -v file="${source}" -v numbers="${FILE_IGNORE_LINES}" '
        # Список номеров пишется заново и тогда, когда правил у файла нет:
        # иначе в нём остались бы номера прошлого файла.
        BEGIN { printf "" > numbers }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            path = $1

            if (path != file) {
                next
            }

            sub(/^[^ \t]+[ \t]+/, "")

            print
            print NR > numbers
        }
    ' "${IGNORE}" > "${FILE_IGNORE}"
}

# Сверка выражений со строками своего файла.
#
# Строку переписали — выражение перестало с ней совпадать, и без сверки
# этого никто не видит: строка снова даёт неубиваемых мутантов, а правило
# ждёт, пока совпадёт с какой-нибудь новой строкой того же файла, и молча
# её ослепит. Поэтому правило, не совпавшее ни с одной строкой, — отказ
# по файлу. Выражение, которое не разбирается, генератор отбрасывает
# с сообщением в журнале, и оно тоже не глушит ничего — такой же отказ.
# Правило, совпавшее больше чем с одной строкой, называется вслух: оно
# законно, но каждая лишняя строка уходит из-под проверки целиком.
#
# Печатает через табуляцию вид (DEAD или WIDE), номер правила в общем
# списке и готовую строку отчёта с местом правила — `путь:строка`.
audit_ignore_rules() {
    "${python}" "${TOOL_ROOT}/lib/audit_ignore.py" "$1" "${FILE_IGNORE}" "${FILE_IGNORE_LINES}" "${IGNORE}"
}

# Записи, чей файл исчез.
#
# Код меняется, а правило остаётся и однажды совпадёт со строкой в другом
# файле — то есть станет слепотой там, где её никто не заводил. Запись
# списка файлов без мутантов так же однажды пропустит молча новый файл
# с тем же путём.
report_stale_paths() {
    local list="$1"
    local what="$2"
    local stale=0
    local path

    [ -n "${list}" ] || return 0

    while IFS= read -r path; do
        if [ ! -f "${path}" ]; then
            echo "   ВНИМАНИЕ: ${what} ссылается на исчезнувший файл: ${path}" >&2
            stale=$((stale + 1))
        fi
    done < <(awk '!/^[[:space:]]*#/ && NF { print $1 }' "${list}" | sort -u)

    if [ "${stale}" -gt 0 ]; then
        echo "   Мёртвые записи надо убрать из ${list}." >&2
    fi
}

# Записан ли файл в список тех, где мутировать нечего.
allowed_empty() {
    [ -n "${EMPTY_LIST}" ] || return 1

    awk -v file="$1" '
        !/^[[:space:]]*#/ && NF && $1 == file { found = 1 }
        END { exit !found }
    ' "${EMPTY_LIST}"
}

# ─── Исполнитель прогона ────────────────────────────────────────────────────

# Прогон тестов для одного мутанта: ненулевой код возврата означает,
# что мутант убит.
#
# Прогон запускается своей группой процессов (`set -m`) и гасится
# по своему пределу времени — вместе со всей группой, то есть вместе
# с узлами, которые успел поднять.
#
# Свой предел нужен потому, что анализатор по своему таймауту прогон
# не убивает: он перестаёт его ждать и идёт к следующему мутанту.
# Мутант, сломавший условие выхода, оставляет прогон крутиться навсегда,
# и за час набегает пара сотен брошенных процессов — каждый с памятью,
# файлами и портом.
#
# Убитый по пределу прогон возвращает ненулевой код, то есть мутант
# считается убитым. Так и есть: зависание под мутантом — это обнаружение
# мутанта, а не пропуск. Честно это лишь при запасе: предел не короче
# двух длительностей набора на исходном коде (verify_baseline). Мутантов,
# убитых пределом, исполнитель записывает в свой журнал, и утилита
# называет их число: убитые одним пределом — повод присмотреться к машине.
#
# Предел — аргумент: база идёт со своим, долгим, а мутанты — с пределом
# своего набора.
#
# Отказ запуска — другое дело. Когда luatest не начинает проверок вовсе
# (неизвестный аргумент, несуществующий путь, нечем запускать), ненулевой
# код ничего не говорит о мутанте, а анализатор всё равно пишет его
# в убитые: сто процентов без единой запущенной проверки. Поэтому
# исполнитель узнаёт такой отказ по выводу luatest, пишет его в журнал
# отказов и выходит своим кодом, а утилита по журналу валит прогон.
#
# Узнаётся отказ по сообщению, которое поднимает сам раннер luatest —
# в разборе аргументов, в настройке прогона или в своих внутренних
# проверках: оно начинается с места в `luatest/runner.lua`. Строки стека
# с тем же файлом («...: in function») в счёт не идут: они есть и у отказа
# загрузки проверок, а его под мутантом вызывает сам мутант, и это честное
# убийство.
#
# Исполнитель — сценарий bash, а не /bin/sh. Анализатор запускает его
# в новой сессии без управляющего терминала, а dash (он и есть /bin/sh
# в Debian) без терминала управление заданиями не включает: `set -m`
# печатает «can't access tty; job control turned off», группы процессов
# не заводятся, и `kill -TERM -${guard}` промахивается. Тогда каждый
# мутант ждал весь предел и числился убитым пределом, выживший укладывался
# в таймаут анализатора с запасом меньше секунды, а зависший luatest
# пределом не гасился. bash заводит группу и без терминала — и 3.2,
# который стоит /bin/sh в macOS. `setsid` не годится: в macOS его нет,
# а при `set -m` он сам делает fork, и `$!` называет не тот процесс.
# Включилось ли управление заданиями, исполнитель проверяет сам.
write_test_runner() {
    local suite="$1"
    local limit="$2"

    mkdir -p "${WORKDIR}"
    cat > "${TEST_RUNNER}" <<RUNNER
#!/usr/bin/env bash
# Один прогон проверок; пишет его tnt-mutants.
#
# Код выхода: 0 — проверки прошли; ${TIMED_OUT} — исчерпан предел времени;
# ${LAUNCH_FAILED} — проверки не запустились (строка запуска или окружение,
# мутант тут ни при чём); иначе — код luatest.
output='${RUNNER_OUTPUT}'
launch_log='${LAUNCH_LOG}'
timeout_log='${TIMEOUT_LOG}'
timeout_mark='${TIMEOUT_MARK}.'\$\$

launch_failed() {
    echo "проверки не запустились: \$1" >&2
    {
        echo "── \${CURRENT_MUTANT_SOURCE:-исходный код}: \$1"
        if [ -f "\${output}" ]; then
            cat "\${output}"
        fi
    } >>"\${launch_log}"
    exit ${LAUNCH_FAILED}
}

cd '${PWD}' || launch_failed 'нет каталога проекта'
export VARDIR='${VARDIR}'
rm -f "\${output}" "\${timeout_mark}"

# Своя группа процессов: иначе убить можно только сам luatest, а узлы,
# которые он поднял, останутся сиротами.
set -m

# Без управления заданиями группа не заведётся, и сторож не погасит ни
# зависший прогон, ни себя: мутант ждал бы весь предел и числился убитым.
case \$- in
    *m*) ;;
    *) launch_failed 'оболочка не включила управление заданиями (set -m)' ;;
esac

'${LUATEST}' ${suite} ${LUATEST_FLAGS} >"\${output}" 2>&1 &
runner=\$!

# Сторож гасится всей своей группой, вместе со своим sleep, и вывод его
# отвязан: осиротевший sleep держал бы канал того, кто читает вывод
# исполнителя, — проверка базы ждала бы его весь предел.
( sleep ${limit}; : >"\${timeout_mark}"; kill -KILL -\${runner} ) >/dev/null 2>&1 &
guard=\$!

wait \${runner}
status=\$?

kill -TERM -\${guard} 2>/dev/null
wait \${guard} 2>/dev/null

if [ "\${status}" -eq 0 ]; then
    exit 0
fi

if [ -e "\${timeout_mark}" ]; then
    rm -f "\${timeout_mark}"
    echo "предел времени ${limit} с исчерпан" >&2

    # Базу судит сама утилита по коду выхода; в журнал идут только мутанты.
    if [ -n "\${CURRENT_MUTANT_SOURCE:-}" ]; then
        echo "── \${CURRENT_MUTANT_SOURCE}" >>"\${timeout_log}"
    fi

    exit ${TIMED_OUT}
fi

# 126 и 127 — оболочке нечем запускать luatest.
if [ "\${status}" -eq 126 ] || [ "\${status}" -eq 127 ]; then
    launch_failed "luatest не запускается, код \${status}"
fi

if grep -q 'Can not load output module' "\${output}" ||
    { grep -E 'luatest/runner[.]lua:[0-9]+: ' "\${output}" | grep -qvE 'luatest/runner[.]lua:[0-9]+: in '; }; then
    launch_failed "luatest отказал до первой проверки, код \${status}"
fi

exit \${status}
RUNNER
    chmod +x "${TEST_RUNNER}"
}

# Текущее время в микросекундах.
#
# Дробную часть EPOCHREALTIME bash пишет через знак локали — в русской это
# запятая, и арифметика её не разберёт. Знаков после него всегда шесть,
# поэтому одни цифры и есть микросекунды.
now_us() {
    local now="${EPOCHREALTIME}"

    echo "${now//[!0-9]/}"
}

# Микросекунды — секундами с одним знаком после точки. Счёт целый:
# printf с дробью тоже пишет знак локали.
format_seconds() {
    local tenths=$((($1 + 50000) / 100000))

    echo "$((tenths / 10)).$((tenths % 10))"
}

# ─── База ───────────────────────────────────────────────────────────────────

# Прогон по исходному коду обязан быть зелёным. Иначе каждый мутант
# «убивается» теми же падениями, и итог показывает сто процентов на
# сломанных тестах — то есть молчит ровно тогда, когда должен кричать.
#
# База идёт тем же исполнителем, что и мутанты, той же строкой запуска:
# сломанный аргумент в строке мутантов иначе прошёл бы мимо неё.
#
# Предел у базы свой, долгий (BASELINE_LIMIT): её длительность меряется,
# и по ней выбирается предел мутантов набора. Выживший мутант проходит
# набор целиком, как база, и предел короче двух её длительностей убил бы
# его первой же задержкой машины — итог показал бы убитых, которых никто
# не проверял.
#
# Тесный предел по умолчанию поднимается до трёх длительностей базы: запас
# вдвое и ещё половина на разброс самой базы. Явный MUTANTS_TIMEOUT
# не трогается: тесный набор записывается в slow_suites, а отказ идёт после
# проверки всех наборов — с пределом, которого хватит каждому.
#
# Предел мутантов набора ложится в suite_limits.
verify_baseline() {
    local suite="$1"
    local status=0
    local report started duration shown needed

    rm -f "${LAUNCH_LOG}"
    started=$(now_us)
    report=$("${TEST_RUNNER}" 2>&1) || status=$?
    duration=$(($(now_us) - started))
    shown=$(format_seconds "${duration}")

    if [ -s "${LAUNCH_LOG}" ]; then
        echo "ОШИБКА: строка запуска проверок сломана — luatest не начал прогон (${report}):" >&2
        sed 's/^/     /' "${LAUNCH_LOG}" >&2
        echo "   Под мутантами каждый прогон отказал бы так же и числился убитым." >&2
        rm -f "${LAUNCH_LOG}"
        exit 1
    fi

    # Код 124 мог вернуть и сам luatest — числом упавших проверок, поэтому
    # предел узнаётся ещё и по словам исполнителя.
    if [ "${status}" -eq "${TIMED_OUT}" ] && [[ "${report}" == *'предел времени'* ]]; then
        echo "Набор ${suite} не уложился в ${BASELINE_LIMIT} с на исходном коде (MUTANTS_BASELINE_LIMIT)." >&2
        echo "   Под мутантами каждый прогон убивался бы пределом и числился убитым." >&2
        echo '   Похоже на зависание; если набор просто долгий — сузьте его (MUTANTS_SUITE)' >&2
        echo '   или поднимите MUTANTS_BASELINE_LIMIT.' >&2
        exit 1
    fi

    if [ "${status}" -ne 0 ]; then
        echo "Тесты не проходят на исходном коде (${suite}, код ${status}): мутационная проверка бессмысленна." >&2
        tail -n 30 "${RUNNER_OUTPUT}" 2>/dev/null | sed 's/^/     /' >&2 || true
        exit 1
    fi

    suite_limits["${suite}"]="${RUN_LIMIT}"

    if [ "$((duration * 2))" -le "$((RUN_LIMIT * 1000000))" ]; then
        echo "   набор зелёный за ${shown} с, предел мутанта ${RUN_LIMIT} с"
        return
    fi

    # Три длительности, округлённые вверх до секунды.
    needed=$(((duration * 3 + 999999) / 1000000))

    if [ "${TIMEOUT_EXPLICIT}" -eq 1 ]; then
        echo "   набор зелёный за ${shown} с"
        echo "Набор ${suite} идёт ${shown} с при пределе ${RUN_LIMIT} с (MUTANTS_TIMEOUT=${TIMEOUT}): мутанты будут убиты по времени." >&2
        slow_suites+=("${suite}")

        if [ "${needed}" -gt "${slow_needed}" ]; then
            slow_needed="${needed}"
        fi

        return
    fi

    suite_limits["${suite}"]="${needed}"
    echo "   набор зелёный за ${shown} с — дольше половины предела ${RUN_LIMIT} с:"
    echo "   предел мутанта поднят с ${RUN_LIMIT} до ${needed} с, иначе выживших убивал бы разброс времени"
}

# ─── Слепые места генератора ────────────────────────────────────────────────

# Генератор читает исходник как C-подобный и Haskell-подобный разом: пара
# «косая черта со звёздочкой» и пара «фигурная скобка с минусом» для него —
# начало блочного комментария, где бы они ни стояли, хоть в строковом
# литерале, хоть в комментарии Lua. Слепа и сама строка с парой, и всё ниже
# неё до строки со своей закрывающей парой включительно, а без закрытия —
# до конца файла. Так же он понимает метку начала тестового кода.
#
# Искать пары мало: пара в последней строке ничего не прячет. Поэтому
# правила применяются дважды кодом самого генератора, с теми же
# исключениями файла: к строкам как есть и к строкам, в которых он пар
# не видит. Строки, где мутанты есть только во втором случае, — ровно то,
# что эвристика спрятала.
#
# Печатает строки с парами (PAIR) и потерянные строки (LOST), номер
# и текст через табуляцию.
scan_blind_spots() {
    "${python}" "${TOOL_ROOT}/lib/blind_spots.py" "$1" "${RULES}" "${FILE_IGNORE}"
}

# ─── Следы оборванного прогона ──────────────────────────────────────────────

# Прогон, убитый без шанса прибраться, оставляет исходник подменённым
# мутантом, а рядом — его копию с суффиксом .um.backup. Дальше всё идёт
# наперекосяк: следующий прогон падает на проверке базы, тесты валятся
# в местах, которых никто не трогал, а при неудачном стечении мутант
# уезжает в коммит. Поэтому копии ищутся при каждом запуске и возвращаются
# на место до всего остального.
recover_interrupted() {
    local recovered=0

    while IFS= read -r -d '' backup; do
        [ -n "${backup}" ] || continue

        local original="${backup%.um.backup}"

        if [ -f "${original}" ] && ! cmp -s "${original}" "${backup}"; then
            cp "${backup}" "${original}"
            echo "Восстановлен после оборванного прогона: ${original}"
            recovered=$((recovered + 1))
        fi

        rm -f "${backup}"
    done < <(find_in_project -name '*.um.backup')

    if [ -d "${BACKUP_DIR}" ]; then
        for backup in "${BACKUP_DIR}"/*.bak; do
            [ -e "${backup}" ] || continue

            original=$(basename "${backup}" .bak | tr '@' '/')

            if [ -f "${original}" ] && ! cmp -s "${original}" "${backup}"; then
                cp "${backup}" "${original}"
                echo "Восстановлен после оборванного прогона: ${original}"
                recovered=$((recovered + 1))
            fi
        done

        rm -rf "${BACKUP_DIR}"
    fi

    if [ "${recovered}" -gt 0 ]; then
        echo "Прежний прогон был прерван: файлов возвращено ${recovered}." >&2
    fi
}

# ─── Замки ──────────────────────────────────────────────────────────────────

# Жив ли прогон, поставивший замок.
#
# В замке лежит PID прогона, и живость проверяется по нему. Прежде она
# проверялась по процессу анализатора, а его между файлами нет: пока прогон
# генерирует мутантов или гоняет базу, ждущий сосед считал замок брошенным,
# снимал его и шёл параллельно. Два прогона разом искажают время,
# а мутант, убитый пределом, числится убитым — итог зелёный, ничего
# не проверив. Замок старого вида, без PID, судится по-старому.
lock_holder_alive() {
    local holder
    holder=$(head -n 1 "$1" 2>/dev/null || true)

    if [[ "${holder}" =~ ^[0-9]+$ ]]; then
        kill -0 "${holder}" 2>/dev/null
        return
    fi

    pgrep -f analyze_mutants >/dev/null 2>&1
}

# Замок прогона.
#
# Во время прогона исходники подменены мутантами: правка файла в это время
# либо потеряется при восстановлении, либо исказит результат, и понять это
# по симптомам почти невозможно — тесты начинают падать там, где их никто
# не трогал.
if [ -e "${LOCK}" ]; then
    if lock_holder_alive "${LOCK}"; then
        echo "Мутационный прогон уже идёт (${LOCK}): исходники сейчас подменены мутантами." >&2
        echo 'Дождитесь его конца — правки файлов в это время теряются.' >&2
        exit 1
    fi

    echo "Замок ${LOCK} остался от прерванного прогона — снимаю." >&2
    rm -f "${LOCK}"
fi

recover_interrupted

# Очередь на машину: пока чужой прогон жив, ждём его, а не запускаемся
# рядом. Замок берётся неделимо — `set -o noclobber` не даёт двум
# ждущим создать файл одновременно.
waited=0

while true; do
    if (set -o noclobber; echo "$$" > "${MACHINE_LOCK}") 2>/dev/null; then
        MACHINE_LOCK_HELD=1
        break
    fi

    if ! lock_holder_alive "${MACHINE_LOCK}"; then
        echo "Замок машины ${MACHINE_LOCK} остался от прерванного прогона — снимаю." >&2
        rm -f "${MACHINE_LOCK}"
        continue
    fi

    if [ "${waited}" -eq 0 ]; then
        echo 'На машине идёт другой мутационный прогон — жду очереди.' >&2
    fi

    if [ "${waited}" -ge "${QUEUE_WAIT}" ]; then
        echo "Очередь не подошла за ${QUEUE_WAIT} с: впереди застрявший прогон." >&2
        exit 1
    fi

    sleep 10
    waited=$((waited + 10))
done

mkdir -p "${WORKDIR}"
echo "$$" > "${LOCK}"
LOCK_HELD=1

report_stale_paths "${IGNORE}" 'правило исключения'
report_stale_paths "${EMPTY_LIST}" "запись списка ${EMPTY_LIST}"

# ─── Базы ───────────────────────────────────────────────────────────────────

# Базы — до всех мутантов и по разу на каждый различный набор.
#
# База перед каждым файлом гоняла бы набор впустую столько раз, сколько
# файлов у пакета, а тесный предел или красный набор вскрывались бы лишь
# на том файле, до которого прогон доходил через час. Исходники между
# файлами возвращаются на место, так что база, проверенная один раз,
# верна для всего прогона.
declare -A suite_limits=()
slow_suites=()
slow_needed=0

for source in "${files[@]}"; do
    [ -f "${source}" ] || continue

    suite="${suite_of[${source}]}"

    if [ -n "${suite_limits[${suite}]:-}" ]; then
        continue
    fi

    echo "── база: ${suite}"
    write_test_runner "${suite}" "${BASELINE_LIMIT}"
    verify_baseline "${suite}"
done

if [ "${#slow_suites[@]}" -gt 0 ]; then
    echo >&2
    echo "Мутационная проверка не начата: предел мутанта ${RUN_LIMIT} с (MUTANTS_TIMEOUT=${TIMEOUT})" >&2
    echo "короче двух длительностей базы у наборов: ${#slow_suites[@]}." >&2
    echo '   Выживший мутант проходит набор целиком, и первая же задержка машины убила бы его' >&2
    echo '   пределом — итог показал бы убитых, которых никто не проверял.' >&2
    echo "   Задайте MUTANTS_TIMEOUT не меньше $((slow_needed + 1)), сузьте набор (MUTANTS_SUITE)" >&2
    echo '   или снимите MUTANTS_TIMEOUT — тогда предел поднимется под набор сам.' >&2
    exit 1
fi

# ─── Мутанты ────────────────────────────────────────────────────────────────

mkdir -p "${BACKUP_DIR}"
total_score=0
checked=0
failures=()

for source in "${files[@]}"; do
    [ -f "${source}" ] || continue

    suite="${suite_of[${source}]}"
    limit="${suite_limits[${suite}]}"
    slug=$(echo "${source}" | tr '/' '@')
    echo "── ${source} (тесты: ${suite}, предел мутанта ${limit} с)"

    write_test_runner "${suite}" "${limit}"

    cp "${source}" "${BACKUP_DIR}/${slug}.bak"

    rm -rf "${MUTANT_DIR}"
    mkdir -p "${MUTANT_DIR}"

    ignore_for "${source}"

    # Мёртвое правило валит файл, но анализ идёт дальше, как и при слепом
    # пятне: правило ничего не глушит, и выжившие на его бывшей строке —
    # ровно то, что надо увидеть, чтобы решить, снимать его или чинить.
    audit=$(audit_ignore_rules "${source}") || {
        echo "   ОШИБКА: сверка правил ${IGNORE} со строками файла не отработала (вывод выше) — мёртвое правило прошло бы молча." >&2
        exit 1
    }

    dead=$(printf '%s\n' "${audit}" | awk -F '\t' '$1 == "DEAD"' | cut -f 3-)
    wide=$(printf '%s\n' "${audit}" | awk -F '\t' '$1 == "WIDE"' | cut -f 3-)

    if [ -n "${wide}" ]; then
        echo "   ВНИМАНИЕ: правила ${IGNORE} накрывают больше одной строки — каждая из них не мутирует вовсе:" >&2
        echo "${wide}" >&2
    fi

    if [ -n "${dead}" ]; then
        dead_count=$(printf '%s\n' "${dead}" | wc -l | tr -d ' ')
        dead_numbers=$(printf '%s\n' "${audit}" | awk -F '\t' '$1 == "DEAD" { printf "%s%s", separator, $2; separator = ", " }')

        echo "   ОШИБКА: правила ${IGNORE} не совпадают ни с одной строкой файла — мёртвые: ${dead_count}" >&2
        echo "${dead}" >&2
        echo '   Такое правило не глушит ничего: его строку переписали, и мутанты на ней снова есть, а само оно' >&2
        echo '   ждёт новой строки, чтобы молча её ослепить. Мутанта, которого можно убить кодом или проверкой,' >&2
        echo '   снимите вместе с правилом; неотличимого — заглушите выражением, исправленным под нынешнюю строку.' >&2
        failures+=("${source} — мёртвые правила исключения: ${dead_count} (строки ${IGNORE}: ${dead_numbers})")
    fi

    # Слепые места ищутся до генерации: отчёт о них нужен и тогда, когда
    # мутантов не получится вовсе. Отказ записывается, но прогон идёт
    # дальше — выжившие в видимой части файла тоже должны быть названы.
    blind=$(scan_blind_spots "${source}") || {
        echo "   ОШИБКА: поиск слепых мест генератора не отработал (вывод выше) — без него проверка могла бы ослепнуть молча." >&2
        exit 1
    }

    pairs=$(printf '%s\n' "${blind}" | awk -F '\t' '$1 == "PAIR" { print "     строка " $2 ": " $3 }')
    lost=$(printf '%s\n' "${blind}" | awk -F '\t' '$1 == "LOST" { print "     строка " $2 ": " $3 }')

    if [ -n "${pairs}" ]; then
        echo '   ВНИМАНИЕ: генератор принимает за начало комментария пары в строках ниже — от каждой' >&2
        echo '   до закрывающей пары, а без неё до конца файла, мутантов нет:' >&2
        echo "${pairs}" >&2
    fi

    if [ -n "${lost}" ]; then
        lost_count=$(printf '%s\n' "${lost}" | wc -l | tr -d ' ')

        echo "   ОШИБКА: за парами остались строки, где сработали бы правила, — генератор их не видит: ${lost_count}" >&2
        echo "${lost}" >&2
        echo "   Обход: в литерале разбить пару конкатенацией ('/' .. '*'), в комментарии — писать словами." >&2
        failures+=("${source} — слепое пятно генератора: строк без мутантов ${lost_count}")
    fi

    # Вывод генератора сохраняется целиком: в нём он сообщает, что отбросил
    # правило или пропустил строку, и больше этого не узнать нигде. Журнал
    # назван по пути файла: счётчик `checked` растёт только после
    # анализатора, и при `continue` журнал по счётчику затёр бы следующий
    # файл. Сбой генератора прогон не роняет — ниже он превращается
    # в «мутантов не получилось».
    gen_log="${WORKDIR}/gen-${slug}.log"

    "${mutator}" "${source}" --only "${RULES}" \
        --ignore "${FILE_IGNORE}" \
        --mutantDir "${MUTANT_DIR}" \
        --cmd "${LUA} -e \"assert(loadfile('${source}')) os.exit(0)\"" \
        > "${gen_log}" 2>&1 || true
    grep -E 'VALID MUTANTS' "${gen_log}" || true

    # Отброшенное правило.
    #
    # Правило, которое не разобралось как регулярное выражение или не похоже
    # на «шаблон ==> замена», генератор не роняет, а выбрасывает с сообщением
    # и идёт дальше; так же молча он идёт дальше без ненайденного файла
    # правил. Сломанная мутация тогда не порождает мутантов ни в одном
    # файле, а сломанный глушитель перестаёт глушить, и итог всё равно сто
    # процентов. Это ошибка в общих правилах, а не свойство файла, поэтому
    # прогон останавливается сразу — замки и исходники вернёт `trap finish`.
    # Строку «FAILED TO FIND RULE ... AS BUILT-IN» генератор печатает
    # всегда, это поиск среди встроенных наборов, и она не ловится.
    # Разбор правил он повторяет в конце, поэтому сообщения идут парами.
    rule_errors=$(
        awk '
            function report(line) {
                if (!seen[line]++) {
                    print "     " line
                }
            }

            /^RULE: / { rule = $0; next }
            /DOES NOT MATCH EXPECTED FORMAT/ { report(rule " — нет разделителя « ==> »"); next }
            /^FAILED TO COMPILE RULE:/ || /^COULD NOT FIND RULE FILE/ { report($0) }
        ' "${gen_log}"
    ) || rule_errors=''

    if [ -n "${rule_errors}" ]; then
        echo "   ОШИБКА: генератор отбросил правила ${RULES} — мутантов по ним нет ни в одном файле:" >&2
        echo "${rule_errors}" >&2
        echo "   Полный вывод генератора: ${gen_log}" >&2
        exit 1
    fi

    # Строки, пропущенные генератором.
    #
    # Прежде чем мутировать строку, генератор проверяет её наспех: подменяет
    # всю строку мусором (открывающая скобка — пробел, пробельные знаки
    # и `* / # -` остаются, всё прочее — `Q`) и компилирует файл.
    # Скомпилировалось — строка объявлена комментарием или мёртвым
    # кодом, и все её мутанты выбрасываются. Одиночное имя или число внутри
    # многострочного вызова, например уровень `0` у `error(...)`, превращается
    # в законное выражение `Q`, так что поломку уровня не проверит никто,
    # а итог покажет сто процентов по неполному файлу. `--noFastCheck` снял бы
    # пятно в корне, но открыл бы мутантов по всему проекту — это отдельное
    # решение. Строки, где не сработало ни одно правило, генератор не проверяет
    # и не называет: мутировать там нечего, это не потеря.
    #
    # Отчёт печатается до проверки числа мутантов: файл, где генератор
    # выбросил всё, иначе ушёл бы в «мутантов не получилось» молча.
    skipped=$(
        awk '
            /^LINE [0-9]+: / && / APPEARS TO BE COMMENT OR DEAD CODE, SKIPPING/ {
                number = $2
                sub(/:$/, "", number)

                text = $0
                sub(/^LINE [0-9]+: /, "", text)
                sub(/ APPEARS TO BE COMMENT OR DEAD CODE, SKIPPING.*$/, "", text)
                sub(/^[ \t]+/, "", text)

                if (!seen[number]++) {
                    print "     строка " number ": " text
                }
            }
        ' "${gen_log}"
    ) || skipped=''

    if [ -n "${skipped}" ]; then
        skipped_count=$(printf '%s\n' "${skipped}" | wc -l | tr -d ' ')

        echo "   ВНИМАНИЕ: генератор пропустил строк: ${skipped_count} — счёл их комментарием или мёртвым кодом, мутантов на них нет:" >&2
        echo "${skipped}" >&2
        echo '   Обход: вынести аргумент в local строкой выше, чтобы вызов стоял одной строкой.' >&2
    fi

    # Ноль мутантов.
    #
    # Он неотличим от слепоты: пара в шапке файла, сломанный глушитель,
    # опечатка в пути — и файл тоже даёт ноль. Пропущенный с нулевым кодом,
    # такой файл докладывал бы успех, ничего не проверив. Поэтому это отказ,
    # если файла нет в списке тех, где мутировать нечего.
    mutant_count=$(find "${MUTANT_DIR}" -name '*.lua' | wc -l | tr -d ' ')

    if [ "${mutant_count}" -eq 0 ]; then
        if allowed_empty "${source}"; then
            echo "   мутантов нет — файл записан в ${EMPTY_LIST}"
        else
            echo "   ОШИБКА: мутантов не получилось — это отказ, а не пропуск: ноль неотличим от слепоты генератора." >&2
            echo "   Если мутировать в файле действительно нечего, запишите его в ${EMPTY_LIST:-mutants.empty} с объяснением." >&2
            echo "   Вывод генератора: ${gen_log}" >&2
            failures+=("${source} — мутантов не получилось")
        fi

        continue
    fi

    # Запись о файле, где мутанты появились, обязана уйти из списка: иначе
    # однажды она молча пропустит настоящую слепоту этого файла.
    if allowed_empty "${source}"; then
        echo "   ОШИБКА: файл записан в ${EMPTY_LIST}, но мутантов у него ${mutant_count} — уберите запись." >&2
        failures+=("${source} — лишняя запись в ${EMPTY_LIST}")
    fi

    # Докуда генератор вообще дошёл.
    #
    # Грубая сверка поверх поиска пар выше: мутанты кончились задолго
    # до конца файла — такое замечается только пересчётом строк руками.
    #
    # Первая строка отличия берётся `awk`, а не `head`: `head` закрывает
    # поток на первой же строке, `diff` получает SIGPIPE, и под `pipefail`
    # это убивает весь прогон — молча, сразу после генерации мутантов.
    #
    # Код возврата `diff` гасится `|| true`: на различающихся файлах он равен
    # единице, а мутант отличается от исходника всегда. Под `pipefail` эта
    # единица роняла бы весь подсчёт, и предупреждение ниже не печаталось бы
    # ни разу.
    last_line=$(
        for mutant in "${MUTANT_DIR}"/*.lua; do
            diff "${source}" "${mutant}" 2>/dev/null | awk 'NR == 1 { print }' || true
        done | grep -oE '^[0-9]+' | sort -n | tail -1
    ) || last_line=''
    total_lines=$(grep -c '' "${source}")

    if [ -n "${last_line}" ] && [ "$((last_line * 10))" -lt "$((total_lines * 7))" ]; then
        echo "   ВНИМАНИЕ: мутанты кончились на строке ${last_line} из ${total_lines}." >&2
        echo '   Похоже на слепое пятно генератора: он принимает за начало блочного' >&2
        echo '   комментария и пару «косая черта со звёздочкой» (например, в образце пути),' >&2
        echo '   и пару «{-» (например, в строковом литерале). Слепота тянется до первой' >&2
        echo '   строки со своей закрывающей парой — «звёздочка с косой чертой» для первой,' >&2
        echo '   «-}» для второй, — а без неё до конца файла. Ищите в исходнике обе пары.' >&2
    fi

    # Список убитых пределом называется по файлу, и прежний список того же
    # файла уходит до прогона: иначе он пережил бы прогон без зависаний.
    timeout_saved="${WORKDIR}/timeout-${slug}.log"
    analyze_log="${WORKDIR}/analyze-${slug}.log"
    rm -f "${LAUNCH_LOG}" "${TIMEOUT_LOG}" "${timeout_saved}"

    # Списки убитых и выживших анализатор пишет в текущий каталог; префикс
    # уводит их в каталог мутантов, чтобы корень проекта оставался чистым.
    score=$(
        "${analyzer}" "${source}" "${TEST_RUNNER}" \
            --mutantDir "${MUTANT_DIR}" --prefix "${MUTANT_DIR}/analysis" \
            --noShuffle --timeout "$((limit + 1))" 2>&1 |
            tee "${analyze_log}" |
            grep 'MUTATION SCORE' | tail -1 | awk '{print $3}'
    )
    restore_sources
    mkdir -p "${BACKUP_DIR}"

    percent=$(awk -v s="${score:-0}" 'BEGIN { printf "%.1f", s * 100 }')
    echo "   мутантов: ${mutant_count}, убито: ${percent}%"

    # Отказ запуска под мутантами: такие мутанты анализатор записал
    # в убитые, хотя ни одна проверка их не видела.
    if [ -s "${LAUNCH_LOG}" ]; then
        launch_failures=$(grep -c '^── ' "${LAUNCH_LOG}" || true)
        launch_saved="${WORKDIR}/launch-${slug}.log"
        mv "${LAUNCH_LOG}" "${launch_saved}"

        echo "   ОШИБКА ПРОВЕРКИ: проверки не запустились на мутантах: ${launch_failures} — они числятся убитыми, ничего не проверив:" >&2
        sed -n '1,12p' "${launch_saved}" | sed 's/^/     /' >&2
        echo "   Полный вывод: ${launch_saved}" >&2
        failures+=("${source} — проверки не запустились на мутантах: ${launch_failures}")
    fi

    # Убитые пределом. Зависание под мутантом — честное обнаружение, и прогон
    # оно не валит, но число названо: при запасе вдвое против базы предел
    # убивает мутанта, сломавшего условие выхода, либо выжившего на машине,
    # которой не хватило и запаса, — отличить их можно только по списку.
    if [ -s "${TIMEOUT_LOG}" ]; then
        timed_out=$(grep -c '^── ' "${TIMEOUT_LOG}" || true)
        mv "${TIMEOUT_LOG}" "${timeout_saved}"

        echo "   убито пределом времени: ${timed_out} (предел ${limit} с), список: ${timeout_saved}"
    fi

    survivors=$(grep 'NOT KILLED' "${analyze_log}" | awk '{print $1}' || true)
    if [ -n "${survivors}" ]; then
        echo '   выжили:'
        while IFS= read -r survivor; do
            [ -n "${survivor}" ] || continue
            echo "     ${survivor}"
            diff "${source}" "${survivor}" | sed 's/^/       /' || true
        done <<< "${survivors}"
    fi

    if awk -v p="${percent}" -v t="${THRESHOLD}" 'BEGIN { exit !(p < t) }'; then
        failures+=("${source} — ${percent}% при пороге ${THRESHOLD}%")
    fi

    total_score=$(awk -v a="${total_score}" -v b="${percent}" 'BEGIN { print a + b }')
    checked=$((checked + 1))
done

# ─── Итог ───────────────────────────────────────────────────────────────────

if [ "${checked}" -gt 0 ]; then
    average=$(awk -v s="${total_score}" -v n="${checked}" 'BEGIN { printf "%.1f", s / n }')
    echo "── итог: файлов ${checked}, средний MSI ${average}%"
fi

# Отказы судятся раньше, чем «проверять было нечего»: файл без мутантов
# и слепой файл до анализатора не доходят, и такой прогон иначе выходил бы
# с нулём.
if [ "${#failures[@]}" -gt 0 ]; then
    echo >&2
    echo "Мутационная проверка не пройдена (${#failures[@]}):" >&2
    for failure in "${failures[@]}"; do
        echo "  ${failure}" >&2
    done
    echo >&2
    echo 'Выживший мутант означает, что поломку кода не заметил ни один тест;' >&2
    echo 'слепое пятно и ноль мутантов — что проверка не смотрела вовсе;' >&2
    echo 'мёртвое правило исключения — что список исключений разошёлся с кодом.' >&2
    exit 1
fi

if [ "${checked}" -eq 0 ]; then
    echo 'Проверять было нечего.'
    exit 0
fi

echo "Порог ${THRESHOLD}% выдержан."

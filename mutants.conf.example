# Настройки tnt-mutants: положите этот файл как mutants.conf в корень проекта.
#
# Файл читается bash: значения — обычные присваивания, список исходников —
# массив, правило выбора набора проверок — функция. Любую настройку можно
# задать и переменной окружения с тем же именем; окружение старше файла.
# Всё, что не задано, берёт умолчание, названное в комментарии.

# Базовая ветка: прогон без аргументов проверяет файлы, изменённые
# относительно неё, — коммиты ветки, правки в дереве и новые файлы.
# Умолчание: origin/main.
#MUTANTS_BASE='origin/main'

# Порог убитых мутантов в процентах. Умолчание: 100.
#MUTANTS_MIN_MSI=100

# Что считается прикладным кодом — pathspec для git, по одному шаблону
# на элемент: фигурные скобки git не раскрывает. Умолчание: весь Lua-код
# проекта без каталогов test/.
#MUTANTS_SOURCES=(
#    ':(glob)src/**/*.lua'
#    ':(glob)libs/*/**/*.lua'
#    ':(exclude,glob)libs/*/test/**'
#)

# Какие проверки гонять для файла. Умолчание: ближайший каталог test/
# вверх по дереву от файла (`libs/<пакет>/test/` для модуля пакета,
# `test/` для остального). Функция печатает набор — аргументы luatest —
# и возвращает ноль; ненулевой код значит «набора нет», и прогон
# откажет до того, как что-либо тронет.
#tests_for() {
#    case "$1" in
#        src/*) echo 'test/unit/' ;;
#        *) return 1 ;;
#    esac
#}

# luatest и аргументы прогона под мутантом. Умолчания: .rocks/bin/luatest
# и `--shuffle none -f` — первое падение решает, что мутант убит.
#MUTANTS_LUATEST='.rocks/bin/luatest'
#MUTANTS_LUATEST_FLAGS='--shuffle none -f'

# Чем проверять, что мутант хотя бы загружается. Умолчание: tarantool.
#MUTANTS_LUA='tarantool'

# Список правил исключения и список файлов без мутантов (формат — в docs/).
# Умолчания: mutants.ignore и mutants.empty в корне проекта; отсутствие
# файлов под этими именами — не отказ, названного явно — отказ.
#MUTANTS_IGNORE='mutants.ignore'
#MUTANTS_EMPTY_LIST='mutants.empty'

# Срок одного мутанта в секундах. Без явного значения берётся 15 с,
# и под долгий набор срок поднимается сам; явный срок не трогается,
# а тесный для набора — отказ до генерации мутантов.
#MUTANTS_TIMEOUT=60

# Сколько ждать прогона набора на исходном коде. Умолчание: 300.
#MUTANTS_BASELINE_LIMIT=300

# Рабочий каталог: мутанты, копии исходников, журналы, замок.
# Умолчание: var/mutants.
#MUTANTS_WORKDIR='var/mutants'

# Окружение Python с universalmutator. Умолчание: .venv в каталоге утилиты.
#MUTANTS_VENV='.venv'

# Где luatest держит каталоги поднятых узлов. Умолчание: /tmp/t-<число
# от пути проекта>, чтобы копии проекта не сносили узлы друг друга.
#MUTANTS_VARDIR='/tmp/t-myproject'

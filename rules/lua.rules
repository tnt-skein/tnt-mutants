# Правила мутаций для Lua. Встроенного набора у universalmutator нет,
# а универсальный написан под C-подобный синтаксис: он ломает Lua на
# комментариях (--), неравенстве (~=) и логических словах (and/or/not).
#
# Правка правил проверяется самопроверкой: tnt-mutants selftest. Она
# гоняет утилиту по образцам из selftest/samples и знает заранее, какие
# строки обязаны дать мутантов, а какие нет. Глушитель шире задуманного
# или сломанное правило валят её, хотя обычный прогон остался бы зелёным.

# Строки, которые мутировать бессмысленно: комментарии, аннотации типов
# и подключение модулей. Без этого до половины мутантов — правки в тексте.
(^\s*--) ==> DO_NOT_MUTATE
(^\s*local\s+\w+\s*=\s*require) ==> DO_NOT_MUTATE

# Из возвратов глушатся только два, и у каждого своя причина. `return Module`
# отдаёт таблицу модуля: подмена ломает подключение целиком, валится любая
# проверка, и такой мутант ничего не проверяет. `return nil` правило раннего
# выхода внизу превращает в него же — мутанта там нет. Любой другой возврат
# (`return true`, `return value`) — развилка, и её поломку обязан заметить
# тест: глушитель `return\s+\w+` глушил бы их все, и прогон показывал бы
# сто процентов по непроверенным веткам.
(^\s*return\s+(?:Module|nil)\s*$) ==> DO_NOT_MUTATE

# Сравнения. В Lua неравенство пишется ~=, а не !=.
(?<![~<>=])==(?![=]) ==> ~=
~= ==> ==
>= ==> >
>= ==> ==
<= ==> <
<= ==> ==
(?<![<>~=])<(?![=]) ==> <=
(?<![<>~=])<(?![=]) ==> >
(?<![<>~=-])>(?![=]) ==> >=
(?<![<>~=-])>(?![=]) ==> <

# Логические связки: в Lua это слова, а не && и ||.
# ВАЖНО: правила разбираются как регулярные выражения Python, а не как
# шаблоны Lua. Классы вида [^%w_] здесь означали бы «не %, не w, не _»,
# и подмена срабатывала бы внутри слов: error превращался в errand.
# Границы слов задаются \b.
\band\b ==> or
\bor\b ==> and
\bnot\s+ ==> 

# Логические константы.
\btrue\b ==> false
\bfalse\b ==> true

# Проверки на nil — самая частая развилка в Lua-коде.
==\s*nil\b ==> ~= nil
~=\s*nil\b ==> == nil

# Арифметика. Конкатенация .. не трогается: подмена её на арифметику
# даёт мутанта, который валится на любом входе, то есть ничего не проверяет.
(?<![.])\+(?![.]) ==> -
(?<![.])\+(?![.]) ==> *
(?<![.])-(?![.=>]) ==> +
(?<![.])\*(?![.]) ==> +
(?<![./])/(?![./]) ==> *

# Числовые границы: смещение на единицу ловит ошибки в диапазонах.
(?<![\w.])(\d+)(?![\w.]) ==> 0
(?<![\w.])(\d+)(?![\w.]) ==> (\1+1)
(?<![\w.])(\d+)(?![\w.]) ==> (\1-1)

# Ранний выход: подменяет возвращаемое значение на nil.
(^\s*)return\s+(.+)$ ==> \1return nil
